from functools import wraps

app = Flask(__name__)
CORS(app)

# Initialiser la connexion DB
db_manager = DatabaseConnection()

# Middleware d'authentification
def require_auth(f):
    @wraps(f)
    def decorated_function(*args, **kwargs):
        token = request.headers.get('Authorization')
        
        if not token:
            return jsonify({'error': 'Token manquant'}), 401
        
        if token.startswith('Bearer '):
            token = token[7:]
        
        payload = AuthService.verify_token(token)
        
        if not payload:
            return jsonify({'error': 'Token invalide ou expiré'}), 401
        
        # Récupérer l'utilisateur
        db = db_manager.get_connection()
        auth_service = AuthService(db)
        user = auth_service.get_user_by_id(payload['user_id'])
        
        if not user:
            return jsonify({'error': 'Utilisateur introuvable'}), 401
        
        request.current_user = user
        return f(*args, **kwargs)
    
    return decorated_function


# Routes d'authentification
@app.route('/api/v1/auth/login', methods=['POST'])
def login():
    data = request.json
    email = data.get('email')
    password = data.get('password')
    
    if not email or not password:
        return jsonify({'error': 'Email et mot de passe requis'}), 400
    
    db = db_manager.get_connection()
    auth_service = AuthService(db)
    
    try:
        user, token = auth_service.login(email, password)
        
        if not user:
            return jsonify({'error': 'Identifiants invalides'}), 401
        
        return jsonify({
            'token': token,
            'user': {
                'id': user.id,
                'nom': user.nom,
                'prenom': user.prenom,
                'email': user.email,
                'role': user.role.value
            }
        }), 200
    
    except Exception as e:
        return jsonify({'error': str(e)}), 500
    finally:
        db.close()


@app.route('/api/v1/auth/register', methods=['POST'])
def register():
    data = request.json
    
    required = ['email', 'password', 'nom', 'prenom', 'role']
    if not all(field in data for field in required):
        return jsonify({'error': 'Champs manquants'}), 400
    
    # Valider email
    if not ValidationService.validate_email(data['email']):
        return jsonify({'error': 'Email invalide'}), 400
    
    # Valider mot de passe
    pwd_validation = ValidationService.validate_password_strength(data['password'])
    if not pwd_validation['valid']:
        return jsonify({'error': 'Mot de passe faible', 'details': pwd_validation['errors']}), 400
    
    db = db_manager.get_connection()
    auth_service = AuthService(db)
    
    try:
        role = UserRole(data['role'])
        user = auth_service.register_user(
            data['email'],
            data['password'],
            data['nom'],
            data['prenom'],
            role
        )
        
        token = AuthService.generate_token(user)
        
        return jsonify({
            'message': 'Utilisateur créé avec succès',
            'token': token,
            'user': {
                'id': user.id,
                'email': user.email
            }
        }), 201
    
    except ValueError as e:
        return jsonify({'error': str(e)}), 400
    except Exception as e:
        return jsonify({'error': 'Erreur lors de la création'}), 500
    finally:
        db.close()


