    user = request.current_user
    
    db = db_manager.get_connection()
    time_service = TimeTrackingService(db)
    
    try:
        # Filtrer par semaine si demandé
        if request.args.get('week_start'):
            week_start = datetime.fromisoformat(request.args.get('week_start'))
            entries = time_service.get_week_entries(user.id, week_start)
        else:
            # Sinon, semaine courante
            from datetime import date
            today = date.today()
            week_start = today - timedelta(days=today.weekday())
            entries = time_service.get_week_entries(user.id, datetime.combine(week_start, datetime.min.time()))
        
        return jsonify({
            'entries': [{
                'id': e.id,
                'tache_id': e.tache_id,
                'date': e.date_travail.isoformat(),
                'heures': e.heures,
                'description': e.description,
                'approuve': e.approuve
            } for e in entries]
        }), 200
    
    except Exception as e:
        return jsonify({'error': str(e)}), 500
    finally:
        db.close()


